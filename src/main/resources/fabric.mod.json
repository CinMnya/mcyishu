    "main": [ "com.chenchen.yishu.YishuMod" ],
    "client": [ "com.chenchen.yishu.client.YishuClient" ]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": "*",
    "minecraft": "${minecraft_dependency}",
    "java": "${java_dependency}"
  }
